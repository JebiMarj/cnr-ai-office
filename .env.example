# Public browser config. These are the only keys the static site may use.
# Supabase → Project Settings → API. Use the anon key or the publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Not read by Vite. Set this in Supabase Edge Function secrets before you deploy.
# Use a long random string. Never commit a real value, and never prefix it with VITE_.
OFFICE_AGENT_SECRET=YOUR_OFFICE_AGENT_SECRET
